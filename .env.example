# Phalanx — Federated Learning Framework
# Copy to .env and customize:  cp .env.example .env
#
# All defaults work for local development. Change only if:
#   • Ports conflict with other services
#   • You're using external HuggingFace datasets
#   • You're deploying to production

# ═══════════════════════════════════════════════════════════════════════════
# SERVICE PORTS
# ═══════════════════════════════════════════════════════════════════════════

API_PORT=8000                              # FastAPI backend
FRONTEND_PORT=80                           # React frontend (production, nginx)
FRONTEND_DEV_PORT=5173                     # Vite dev server (development)
DOCS_PORT=8080                             # Zensical documentation

# ═══════════════════════════════════════════════════════════════════════════
# CELERY TASK QUEUE (Simulations Execution)
# ═══════════════════════════════════════════════════════════════════════════

CELERY_BROKER_URL=redis://redis:6379/0     # Task queue
CELERY_RESULT_BACKEND_URL=redis://redis:6379/1  # Results storage
CELERY_CONCURRENCY=1                       # Parallel workers: 1 for single GPU, N for multi-GPU

# ═══════════════════════════════════════════════════════════════════════════
# HUGGINGFACE (ONLY needed for gated datasets)
# ═══════════════════════════════════════════════════════════════════════════

HF_HOME=./cache/huggingface                # Dataset cache location
# HF_TOKEN=hf_abc123...                    # Uncomment + paste token if using private datasets
                                           # Get token: https://huggingface.co/settings/tokens

# ═══════════════════════════════════════════════════════════════════════════
# VITE FRONTEND (Development mode only — ignored in production)
# ═══════════════════════════════════════════════════════════════════════════

VITE_API_PROXY_TARGET=http://api:8000      # API backend proxy
VITE_DOCS_PROXY_TARGET=http://docs:8000    # Docs proxy
VITE_DOCS_PORT=8080                        # Must match DOCS_PORT
