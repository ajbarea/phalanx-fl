# Phalanx — optional environment configuration. Copy to `.env` (gitignored).
# All values are optional; the app runs with sensible defaults if unset.

# --- OpenTelemetry ---
# Point traces + metrics at an OTLP collector (Jaeger, Grafana Tempo, OTel Collector).
# Leave unset to record telemetry without exporting (no connection noise).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
#
# Print spans to the terminal instead of exporting (what `make trace` sets):
# OTEL_TRACES_EXPORTER=console

# --- HuggingFace Hub ---
# A token raises model/dataset download rate limits (anonymous limits are low).
# HF_TOKEN=
# Silence the Hub usage-telemetry ping during downloads:
# HF_HUB_DISABLE_TELEMETRY=1

# --- Running alongside another Flower project ---
# Set all three: FLWR_HOME alone does not isolate a run, because the SuperLink's
# two ports are shared by whoever finds them. Both port vars are undocumented.
# FLWR_HOME=~/.flwr-phalanx
# FLWR_LOCAL_RUNTIME_API_PORT=39091
# FLWR_LOCAL_CONTROL_API_PORT=39093
