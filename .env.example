# IntelliFL Environment Configuration
# Copy to .env and customize:  cp .env.example .env
# .env is gitignored and never committed.

# Host port mappings (container-internal ports never change)
API_PORT=8000
FRONTEND_PORT=80
FRONTEND_DEV_PORT=5173
DOCS_PORT=8080

# Celery task queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND_URL=redis://redis:6379/1
CELERY_CONCURRENCY=1

# HuggingFace (https://huggingface.co/settings/tokens)
HF_HOME=./cache/huggingface
HF_TOKEN=

# Vite frontend settings (dev only)
VITE_API_PROXY_TARGET=http://api:8000
VITE_DOCS_PROXY_TARGET=http://docs:8000
VITE_DOCS_PORT=8080
