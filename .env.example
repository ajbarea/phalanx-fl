# IntelliFL Docker Configuration
# Copy this file to .env and adjust values as needed

# API Service
API_PORT=8000

# Frontend Service
FRONTEND_PORT=80

# Celery Worker
CELERY_CONCURRENCY=1

# Celery Configuration (usually don't need to change these)
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND_URL=redis://redis:6379/1
