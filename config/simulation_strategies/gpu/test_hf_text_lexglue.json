{
  "shared_settings": {
    "strict_mode": false,
    "aggregation_strategy_keyword": "krum",
    "remove_clients": false,
    "dataset_source": "huggingface",
    "dataset_keyword": "lexglue",
    "use_llm": true,
    "num_of_rounds": 3,
    "num_of_clients": 5,
    "num_of_malicious_clients": 1,
    "model_type": "transformer",
    "llm_model": "distilbert-base-uncased",
    "llm_finetuning": "lora",
    "llm_task": "mlm",
    "llm_chunk_size": 128,
    "mlm_probability": 0.15,
    "lora_rank": 4,
    "lora_alpha": 16,
    "lora_dropout": 0.1,
    "lora_target_modules": ["q_lin", "v_lin"],
    "num_krum_selections": 1,
    "training_device": "gpu",
    "cpus_per_client": 1,
    "gpus_per_client": 0.9,
    "num_of_client_epochs": 1,
    "batch_size": 16,
    "training_subset_fraction": 0.8,
    "min_fit_clients": 2,
    "min_evaluate_clients": 2,
    "min_available_clients": 2,
    "evaluate_metrics_aggregation_fn": "weighted_average",
    "show_plots": false,
    "save_plots": false,
    "save_csv": false,
    "preserve_dataset": false,
    "save_attack_snapshots": true,
    "attack_snapshot_format": "pickle_and_visual",
    "snapshot_max_samples": 3,
    "attack_schedule": [
      {
        "start_round": 2,
        "end_round": 3,
        "attack_type": "token_replacement",
        "selection_strategy": "specific",
        "malicious_client_ids": [0]
      }
    ]
  },
  "simulation_strategies": [
    {
      "display_name": "Test: HuggingFace Text Dataset - LexGLUE"
    }
  ]
}