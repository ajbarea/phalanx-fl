{
    "_title": "PID-Based Removal with Termination Policy (GPU)",
    "shared_settings": {
        "aggregation_strategy_keyword": "pid_standardized",
        "remove_clients": true,
        "dataset_keyword": "bloodmnist",
        "model_type": "cnn",
        "use_llm": false,
        "num_of_rounds": 15,
        "num_of_clients": 10,
        "show_plots": false,
        "save_plots": true,
        "save_csv": true,
        "preserve_dataset": false,
        "training_subset_fraction": 0.8,
        "training_device": "gpu",
        "cpus_per_client": 1,
        "gpus_per_client": 0.9,
        "min_fit_clients": 5,
        "min_evaluate_clients": 5,
        "min_available_clients": 10,
        "evaluate_metrics_aggregation_fn": "weighted_average",
        "num_of_client_epochs": 1,
        "batch_size": 32,
        "strict_mode": false,
        "num_std_dev": 1.5,
        "Kp": 1.0,
        "Ki": 0.1,
        "Kd": 0.05,
        "begin_removing_from_round": 3,
        "termination_policy": "adaptive",
        "min_clients_ratio": 0.3,
        "save_attack_snapshots": true,
        "attack_snapshot_format": "pickle",
        "snapshot_max_samples": 5
    },
    "simulation_strategies": [
        {
            "num_of_malicious_clients": 4,
            "attack_schedule": [
                {
                    "start_round": 1,
                    "end_round": 5,
                    "attack_type": "label_flipping",
                    "selection_strategy": "specific",
                    "malicious_client_ids": [0, 1]
                },
                {
                    "start_round": 6,
                    "end_round": 10,
                    "attack_type": "gaussian_noise",
                    "selection_strategy": "specific",
                    "malicious_client_ids": [2, 3],
                    "target_noise_snr": 10,
                    "attack_ratio": 0.8
                },
                {
                    "start_round": 11,
                    "end_round": 15,
                    "attack_type": "model_poisoning",
                    "selection_strategy": "specific",
                    "malicious_client_ids": [0, 1, 2, 3],
                    "poison_ratio": 0.2,
                    "magnitude": 5.0
                }
            ]
        }
    ]
}
